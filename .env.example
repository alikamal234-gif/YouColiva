# ==============================================================================
# YouColiva Environment Variables Template
# Copy this file to .env in local development: cp .env.example .env
# NEVER commit real production secrets or API keys to version control.
# ==============================================================================

# Node Environment ('development', 'test', 'production')
NODE_ENV=development

# Server Port
PORT=4000

# Client Origins for CORS (comma-separated if multiple)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# MongoDB Connection URI
# Development default uses local MongoDB; tests can also use in-memory server
MONGODB_URI=mongodb://127.0.0.1:27017/youcoliva_dev

# JWT Secrets (Will be used in Milestone C - placeholder tokens)
JWT_ACCESS_SECRET=your_dev_jwt_access_secret_min_32_characters_long
JWT_REFRESH_SECRET=your_dev_jwt_refresh_secret_min_32_characters_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
